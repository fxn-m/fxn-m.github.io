{
  "name": "fxn-m.com",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://fxn-m.com/",
  "type": "module",
  "scripts": {
    "build": "bun run type-check && bun run build-only",
    "build:markdown": "bun ./scripts/buildBlog.ts",
    "build-only": "vite build",
    "check": "bun run format:check && bun run lint && bun run type-check",
    "dev": "vite",
    "dev:server": "wrangler dev --var BLOG_PREVIEW:true",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings . && bun run lint:tailwind",
    "lint:fix": "oxlint --fix --deny-warnings . && bun run lint:tailwind:fix",
    "lint:tailwind": "bun ./scripts/lintTailwind.ts",
    "lint:tailwind:fix": "bun ./scripts/lintTailwind.ts --fix",
    "preview": "vite preview",
    "test:server": "vitest run",
    "test:server:watch": "vitest",
    "typegen:worker": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-env=false",
    "type-check": "bun run type-check:app && bun run type-check:server",
    "type-check:app": "tsc --noEmit -p tsconfig.json",
    "type-check:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@ai-sdk/google": "^3",
    "@notionhq/client": "5.23.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-query": "5.101.2",
    "ai": "^6",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "fuse.js": "7.4.2",
    "geist": "^1.7.2",
    "he": "1.2.0",
    "highlight.js": "11.11.1",
    "hono": "4.12.28",
    "notion-to-md": "4.0.0-alpha.4",
    "p-limit": "^6",
    "posthog-js": "1.399.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.2.0",
    "showdown": "2.1.0",
    "slugify": "1.6.9",
    "tailwindcss": "4.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@tailwindcss/node": "4.3.2",
    "@tailwindcss/oxide": "4.3.2",
    "@types/he": "1.2.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/showdown": "2.0.6",
    "@vitejs/plugin-react": "6.0.3",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  },
  "packageManager": "bun@1.3.14"
}
