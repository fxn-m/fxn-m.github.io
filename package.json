{
  "name": "fxn-m.com",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://fxn-m.com/",
  "type": "module",
  "scripts": {
    "build": "bun run type-check && bun run build-only",
    "build:markdown": "bun ./scripts/buildBlog.ts",
    "build-only": "vite build",
    "check": "bun run format:check && bun run lint && bun run type-check",
    "dev": "vite",
    "dev:server": "wrangler dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "preview": "vite preview",
    "type-check": "bun run type-check:app && bun run type-check:server",
    "type-check:app": "tsc --noEmit -p tsconfig.app.json",
    "type-check:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@ai-sdk/google": "^3",
    "@notionhq/client": "5.23.0",
    "ai": "^6",
    "cheerio": "1.2.0",
    "dotenv": "17.4.2",
    "he": "1.2.0",
    "notion-to-md": "4.0.0-alpha.4",
    "p-limit": "^6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "showdown": "2.1.0",
    "slugify": "1.6.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/he": "1.2.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/showdown": "2.0.6",
    "@vitejs/plugin-react": "6.0.3",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "packageManager": "bun@1.3.14"
}
